{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/track-reads.sh",
            "timeout": 1000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gate-edit.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/prewrite-claim-gate.sh",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
