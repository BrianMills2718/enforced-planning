{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enforced-planning:pr-review-signoff-semantic:1.0",
  "title": "SemanticReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_lane",
    "head_sha",
    "verdict",
    "criterion_results",
    "findings",
    "summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "review_lane": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"type": "string", "enum": ["pass", "fail", "inconclusive"]},
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "outcome", "evidence_refs", "rationale"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["pass", "fail", "inconclusive"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "summary", "evidence_refs"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["blocking", "advisory"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          }
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  }
}
