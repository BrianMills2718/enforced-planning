      "acceptance": [
        {
          "id": "OPAD01-A1",
          "criterion": "New classed contracts use an explicit controlled portfolio class and exact Project Graph owner/lifecycle authority rather than caller-selected identity.",
          "evidence_required": [
            "Schema-version compatibility controls",
            "Exact graph commit, file, and record digests",
            "Owner, status, record-kind, and governance validation"
          ],
          "negative_control": "Legacy, unregistered, inactive, pointer, unreviewed, owner-mismatched, or tampered graph input cannot create portfolio proof."
        },
        {
          "id": "OPAD01-A2",
          "criterion": "A separate append-only command allocates at most one product per owner class and one global maintenance/external-obligation slot with byte-idempotent replay.",
          "evidence_required": [
            "Exact claim/scenario/request bindings",
            "Active bucket reconstruction",
            "Ledger byte comparison across replay",
            "Competing product and non-product denials"
          ],
          "negative_control": "First selection never auto-allocates; conflicting id/file/request or malformed history fails before mutation."
        },
        {
          "id": "OPAD01-A3",
          "criterion": "Schema-1.1 selection fails without its exact active allocation, retains the allocation digest on success, and becomes invalid after disposition while legacy selection remains compatible.",
          "evidence_required": [
            "Missing-allocation selection denial",
            "Selected binding allocation id/digest",
            "Post-disposition resolution denial",
            "Legacy regression result"
          ],
          "negative_control": "An allocation for a different contract, outcome, class, project, claim, or disposed event cannot authorize selection."
        },
        {
          "id": "OPAD01-A4",
          "criterion": "The real Plan 120 claim executes maintenance allocate, exact replay, select, selected observe, and park against a current exact Project Meta revision without claiming mandatory fleet writes.",
          "evidence_required": [
            "Live claim and tracker refs",
            "Allocation, graph authority, selection, and disposition digests",
            "Ordinary and selected observation receipts",
            "Candidate revision and focused checks"
          ],
          "negative_control": "Evidence explicitly denies product-project choice, auto-selection, hard ordinary pre-write, installer, deployment, and fleet claims."
        }
      ],
