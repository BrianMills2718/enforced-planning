      "title": "Bind deliberate outcome allocation and selection to exact Project Graph authority",
      "class": "integration",
      "objective": "Require new classed outcome selection to consume a separately recorded, append-only portfolio allocation whose project lifecycle and owner class are resolved from one exact Project Meta Git revision; cap product WIP per owner class and maintenance/external-obligation WIP globally without changing ordinary pre-write authority.",
      "profile": "standard",
      "execution_class": "independently_executable",
      "claimability": "ready_for_execution",
      "authorization_mode": "registry_claim",
      "scope": {
        "included": [
          "Backward-compatible schema-1.1 outcome portfolio class",
          "Exact Git-object Project Graph loader and digest-bound authority model",
          "Exact live-claim allocation and disposition request loading",
          "Append-only atomic portfolio allocation ledger",
          "One product allocation per reviewed Project Graph owner class",
          "One shared global maintenance or external-obligation allocation",
          "Byte-idempotent allocation and disposition replay",
          "Hard classed selected-outcome admission against an exact active allocation",
          "Legacy schema-1.0 selection compatibility without portfolio-admission claims",
          "Public allocation/disposition CLI",
          "One owner-real Plan 120 maintenance allocate/select/observe/park journey",
          "Focused tests, evidence, operator guide, plan, graph, index, and roadmap"
        ],
        "excluded": [
          "Project Graph mutation or a second static authority",
          "Automatic first-writer allocation",
          "Mandatory outcome selection for every claim or plan",
          "Ordinary pre-write, claim, worktree, commit, shell, or closeout enforcement",
          "Choosing Brian's one product project",
          "Independent semantic verification of progress receipts",
          "Installer, host-hook, downstream repository, colleague, fleet, deployment, or release rollout",
          "Cost or elapsed-time authorization"
        ]
      },
