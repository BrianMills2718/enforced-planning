      "scope": {
        "included": [
          "Revision-bound snapshot of current live claim structures",
          "Pre-registered positive, negative, validation, held-out, and calibration cases",
          "Ordinary-authority baseline",
          "Deterministic candidate admission overlay",
          "Positive, negative, and corruption controls",
          "Per-case false-block, false-allow, safe-operation, and bypass readout",
          "Exact repeated-run reproduction digest",
          "Coverage grading and fresh execution-based sign-off",
          "Truthful plan, work graph, evidence, guide, index, and roadmap closeout"
        ],
        "excluded": [
          "Activation of a hard lifecycle or write hook",
          "Cross-repository allocation membership",
          "Installer or downstream fleet rollout",
          "Semantic verification of progress receipt meaning",
          "Selection of Brian's one active product outcome",
          "Break-glass implementation",
          "Cost or elapsed-time authorization"
