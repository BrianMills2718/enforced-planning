      "acceptance": [
        {
          "id": "OAEV01-A1",
          "criterion": "Population, cases, labels, thresholds, and non-claims are frozen before candidate implementation.",
          "evidence_required": [
            "Pre-implementation commit",
            "Exact plan and fixture digests",
            "Unique case ids and declared splits"
          ],
          "negative_control": "A post-run fixture or label change is retained as a new suite revision and cannot overwrite the frozen result."
        },
        {
          "id": "OAEV01-A2",
          "criterion": "The candidate composes ordinary authority, safe operations, bootstrap scope, active allocation, and continuation state into typed per-case decisions.",
          "evidence_required": [
            "Focused deterministic tests",
            "All 30 case decisions",
            "Ordinary denial precedence"
          ],
          "negative_control": "Active outcome state cannot override an ordinary authority denial."
        },
        {
          "id": "OAEV01-A3",
          "criterion": "Known-good, known-bad, and in-memory corruption controls demonstrate that the evaluator can both allow and reject.",
          "evidence_required": [
            "Positive control receipt",
            "Negative control receipt",
            "Detected corruption mismatch"
          ],
          "negative_control": "A scorer that accepts the inverted expectation invalidates the run."
        },
        {
          "id": "OAEV01-A4",
          "criterion": "Every scored case meets the zero-error thresholds and exact rerun reproduces the canonical result digest.",
          "evidence_required": [
            "Per-case baseline and candidate results",
            "Metric summary",
            "Repeated canonical digest"
          ],
          "negative_control": "No aggregate score can hide one critical false block or false allow."
        },
        {
          "id": "OAEV01-A5",
          "criterion": "Coverage grading and fresh execution-based sign-off disposition the evidence before any hard-gate decision.",
          "evidence_required": [
            "Coverage report",
            "Independent verifier identity and exact rerun",
            "Bounded promote/revise/stop decision"
          ],
          "negative_control": "Implementer self-report alone cannot promote the gate."
        }
      ],
