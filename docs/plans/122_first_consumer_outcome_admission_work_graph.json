      "acceptance": [
        {
          "id": "OAG01-A1",
          "criterion": "One production decision owns admission ordering and reproduces every frozen Plan 121 case.",
          "evidence_required": [
            "Plan 121 full-suite regression",
            "Evaluator delegates to the production owner",
            "Ordinary-denial precedence negative control"
          ],
          "negative_control": "A changed duplicate candidate implementation cannot silently diverge from production."
        },
        {
          "id": "OAG01-A2",
          "criterion": "The source-consumer bootstrap permits only nonempty exact Plan, index, roadmap, and Plan 122 admission-input paths.",
          "evidence_required": [
            "Public bootstrap allow receipt",
            "Source-path smuggling denial",
            "Empty and wrong-plan denial"
          ],
          "negative_control": "Adding one enforced_planning, scripts, tests, evidence, traversal, or foreign-plan path denies the bundle before mutation."
        },
        {
          "id": "OAG01-A3",
          "criterion": "Selected admission derives exact live portfolio and effective continuation state from current canonical owners.",
          "evidence_required": [
            "Exact claim/tracker/binding/scenario/allocation digests",
            "Current effective lease digest",
            "Missing, inactive, mismatched, target, and circular controls"
          ],
          "negative_control": "No public option accepts caller-supplied active portfolio or continuation labels."
        },
        {
          "id": "OAG01-A4",
          "criterion": "Explicit session start/heartbeat and pre-write adapters deny before mutation or success while default behavior remains compatible.",
          "evidence_required": [
            "Before/after tracker byte or timestamp checks",
            "Ordinary-allow/outcome-deny public command",
            "Default-off focused regressions"
          ],
          "negative_control": "Outcome failure cannot be reduced to an observe notice in explicit hard mode."
        },
        {
          "id": "OAG01-A5",
          "criterion": "The real Plan 122 lane passes bootstrap, exact allocation/selection, heartbeat, and target pre-write admission with retained both-sign evidence.",
          "evidence_required": [
            "Live claim and tracker refs",
            "Project Graph and allocation refs",
            "Positive admission receipts",
            "Public-command negative receipts",
            "Focused verification and candidate revision"
          ],
          "negative_control": "Evidence explicitly denies hook activation, installer/fleet adoption, cross-repository membership, semantic progress certification, and product selection."
        }
      ],
