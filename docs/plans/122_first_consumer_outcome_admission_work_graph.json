      "title": "Implement and exercise first-consumer outcome admission",
      "class": "implementation",
      "objective": "Turn the independently signed-off admission ordering into one exact-state, opt-in Enforced Planning consumer without activating hooks or expanding to fleet scope.",
      "profile": "standard",
      "execution_class": "independently_executable",
      "claimability": "exclusive",
      "authorization_mode": "registry_claim",
      "scope": {
        "included": [
          "Canonical production outcome-admission decision",
          "Plan 121 evaluator delegation to the production decision",
          "Fixed source-consumer allocation bootstrap classifier",
          "Exact selected claim, tracker, scenario, allocation, and effective continuation resolution",
          "Append-only admission decision receipts",
          "Explicit opt-in session start, heartbeat, and native pre-write integration",
          "Sanctioned worktree bootstrap integration with default-off compatibility",
          "Authentic Plan 122 positive journey",
          "Public-command missing-selection, circular-continuation, and bootstrap-smuggling negative controls",
          "Truthful source guide, index, roadmap, and evidence closeout"
        ],
        "excluded": [
          "Hook activation",
          "meta-process.yaml default changes",
          "Installer or generated-mirror propagation",
          "Downstream or fleet adoption",
          "Cross-repository allocation membership",
          "Semantic certification of progress evidence",
          "Selection of Brian's active product outcome",
          "Cryptographic resistance to shared-identity bypass"
        ]
      },
