      ],
      "acceptance": [
        {
          "id": "QCOP02-A1",
          "criterion": "The installed QC consumer is exact-source-bound, local, and limited to the frozen pilot manifest.",
          "evidence_required": [
            "Installer/generator action manifest",
            "Installed file digests and local import receipts",
            "Primary-checkout and unrelated-repository non-mutation inventory"
          ],
          "negative_control": "A full or worktree-only installer expansion stops rather than silently broadening the pilot."
        },
        {
          "id": "QCOP02-A2",
          "criterion": "Representative ordinary pre-write targets pass with zero compliant false blocks, zero outside-claim false allows, and local p95 at or below 250 ms before enforcement.",
          "evidence_required": [
            "Frozen preflight cases and results",
            "Ordinary receipts",
            "Latency summary"
          ],
          "negative_control": "One compliant false block or outside-claim false allow prevents activation."
        },
        {
          "id": "QCOP02-A3",
          "criterion": "Active exact QC selection admits flagless Make lifecycle and two distinct contract-scoped native writes.",
          "evidence_required": [
            "QC claim/tracker/allocation/selection digests",
            "Heartbeat and both-sign prewrite receipts",
            "Distinct target paths"
          ],
          "negative_control": "Caller flags, approval text, cost, or elapsed time cannot manufacture active state."
        },
        {
          "id": "QCOP02-A4",
          "criterion": "The installed sanctioned bootstrap admits only one exact Plan-numbered artifact lane.",
          "evidence_required": [
            "Authentic Make bootstrap receipt",
            "Restricted child claim",
            "Source-smuggling denial and child closeout"
          ],
          "negative_control": "One source, test, traversal, or foreign-Plan path denies before claim/worktree creation."
        },
        {
          "id": "QCOP02-A5",
          "criterion": "Parking the QC allocation denies flagless heartbeat and ordinary-authorized native pre-write before mutation.",
          "evidence_required": [
            "Disposition and ledger digests",
            "Terminal admission receipts",
            "Heartbeat and target before/after hashes"
          ],
          "negative_control": "Ordinary allow cannot revive an inactive allocation."
        },
        {
          "id": "QCOP02-A6",
          "criterion": "Rollback and stable-product controls pass without model calls, deployment, user-data changes, product selection, or fleet claims.",
          "evidence_required": [
            "Activation and rollback refs",
            "Focused QC product/control checks",
            "Explicit non-mutation and non-promotion inventory"
          ],
          "negative_control": "Governance installation alone cannot be reported as product progress or fleet adoption."
        }
