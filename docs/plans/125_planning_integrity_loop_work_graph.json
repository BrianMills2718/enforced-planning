          "access": "exclusive",
          "coordination_key": "planning-integrity-v1"
        }
      ],
      "acceptance": [
        {
          "id": "PI02-A1",
          "criterion": "A complete declared plan yields an exact passing result while omitted, malformed, unsupported, and checker-error cases never yield pass.",
          "evidence_required": [
            "Focused parser and result tests",
            "Exact plan and validator digests"
          ],
          "negative_control": "A plan missing its frontier and reassessment contract fails."
        },
        {
          "id": "PI02-A2",
          "criterion": "Configured coordinated or release work resolves one full Git commit once, reads plan, config, graph, and approvals from that revision, retains it in claim/tracker custody, and passes only that revision through readiness, claim, branch, worktree, and session creation; direct acquisition and existing branch/worktree identities cannot substitute another revision.",
          "evidence_required": [
            "Installed Make vertical with symbolic HEAD movement",
            "Claim, tracker, and worktree HEAD equality assertion",
            "Dirty-working-tree and old-good-revision direct-claim bypass controls",
            "Existing branch/worktree mismatch controls",
            "Split-revision plan/graph control",
            "Pre-existing claim/branch rollback ownership controls",
            "Injected branch-creation race using the helper ownership receipt",
            "Legacy v3 claim-with-tracker rejection without fabricated v4 custody"
          ],
          "negative_control": "Explicitly unplanned light work and below-floor historical plans retain documented compatibility."
        },
        {
          "id": "PI02-A3",
          "criterion": "Source and installed commands use the same implementation, worktree-only install includes the readiness entrypoint's transitive import closure, and installer rerun is idempotent.",
          "evidence_required": [
            "Installed consumer test",
            "Installer second-run no-op result",
            "Canonical template propagation assertions",
            "Relationship-coupling assertion",
            "Clean worktree-only installed readiness CLI execution"
          ]
        },
        {
          "id": "PI02-A4",
          "criterion": "Observe mode exposes typed integrity findings without denial, while duplicate governed headings or fields and absolute or traversing configured plan paths fail visibly.",
          "evidence_required": [
            "Observed-failure CLI output control",
            "Duplicate heading/field controls",
            "Non-portable path controls"
          ]
        }
      ],
