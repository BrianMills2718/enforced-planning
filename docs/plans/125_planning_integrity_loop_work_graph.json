        }
      ],
      "outputs": [
        "Typed Planning Integrity result",
        "Pre-mutation semantic plan admission",
        "Non-omittable direct-claim enforcement",
        "Schema-versioned claim and tracker start-revision custody",
        "Operator-visible observe findings",
        "Installed wrapper and config support",
        "Focused both-sign evidence"
      ],
