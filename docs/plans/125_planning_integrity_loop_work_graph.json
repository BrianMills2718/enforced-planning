          "id": "PI02-A4",
          "criterion": "Observe mode exposes typed integrity findings without denial, while duplicate governed headings or fields and absolute or traversing configured plan paths fail visibly.",
          "evidence_required": [
            "Observed-failure CLI output control",
            "Duplicate heading/field controls",
            "Non-portable path controls"
          ]
        }
