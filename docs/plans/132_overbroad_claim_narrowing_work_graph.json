      "id": "cn132-01-source-atomic-claim-narrowing",
      "initiative_id": "coordination-integrity",
      "goal_id": "claim-granularity-and-safe-narrowing",
      "design_revision": "user-approved:codex-session-01a058cd-44d2-7ca0-92bb-c3ce68f04960:2026-08-31;audited-v2:2026-09-01",
      "spec_revision": "plan-132-adopted-v2-audited",
      "title": "Implement atomic broad-claim narrowing and source-consumer enforcement",
      "class": "implementation",
      "objective": "Extend the canonical claim registry with compatible broad-scope metadata, separated session target and mutation authority, owner-only fail-atomic claim/projection narrowing, truthful post-commit receipts, explanatory conflicts, bootstrap pre-write denial, and one disposable installed-consumer replay without weakening parent-child exclusion.",
      "profile": "standard",
      "execution_class": "independently_executable",
      "claimability": "ready_for_execution",
      "authorization_mode": "registry_claim",
      "scope": {
        "included": [
          "Claim schema v6 broad-scope metadata and legacy read compatibility",
          "Exact session target separated from legacy-visible mutation worktree authority",
          "Owner/session-bound subset-only atomic narrow transaction",
          "Fail-atomic claim/projection transition and truthful post-commit mutation receipt",
          "Exact versus parent-side conflict classification and advisory Git evidence",
          "Bootstrap broad-mode pre-write denial",
          "Source CLI, Make template, installer propagation, operator docs, and focused tests",
          "Disposable installed deny-narrow-admit journey and Plan 132 evidence"
        ],
        "excluded": [
          "Weakening parent-child overlap",
          "Git diff as admission authority",
          "Automatic claim revocation or takeover",
          "A second mailbox, registry, lock, or policy store",
          "Real Project Meta mutation",
          "Fleet installation or hard-enforcement rollout"
        ]
      },
