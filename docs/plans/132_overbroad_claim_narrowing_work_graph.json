      "acceptance": [
        {
          "id": "CN132-A1",
          "criterion": "An owner can fail-atomically narrow claim plus projection to strict descendant paths, after which a previously denied disjoint child claim is admitted while true overlap remains denied and the append-only receipt truthfully reports post-commit state.",
          "evidence_required": [
            "Temporary-registry deny-narrow-admit transcript",
            "Claim and projection digest transition",
            "Existing parent-child denial regression"
          ],
          "negative_control": "Foreign-session, sibling escape, expansion, empty replacement, and failed projection refresh leave claim and projection bytes unchanged; receipt failure reports applied_projection_current rather than false rollback."
        },
        {
          "id": "CN132-A2",
          "criterion": "New broad claims carry explicit bootstrap or bounded intent; bootstrap target resolution remains separate from mutation authority, ordinary writes are denied before narrowing, old projection readers fail closed, and legacy claims remain readable.",
          "evidence_required": [
            "Schema v6 round-trip tests",
            "Workspace-root target resolution plus pre-write deny then post-narrow allow",
            "Old-reader/new-projection and old-projection-writer fail-closed controls",
            "Legacy schema compatibility fixture"
          ],
          "negative_control": "Missing reason, contradictory narrow metadata, ambiguous root, and unsupported mode deny before claim or worktree residue."
        },
        {
          "id": "CN132-A3",
          "criterion": "Conflict receipts distinguish exact, candidate-parent, and owner-parent overlap and may expose current-diff disjointness only as advisory evidence.",
          "evidence_required": [
            "Structured interaction tests",
            "Human and JSON CLI snapshots"
          ],
          "negative_control": "Changing advisory diff state cannot change hard-conflict severity or admit a candidate."
        },
        {
          "id": "CN132-A4",
          "criterion": "Source, Make template, installer, and generated consumer expose the same narrowing contract and a disposable installed repo completes the canonical journey.",
          "evidence_required": [
            "Installer parity tests",
            "Disposable installed-consumer transcript",
            "Framework self-test"
          ],
          "negative_control": "A generated consumer missing the narrow CLI, broad metadata, or projection fields fails parity before being used as rollout evidence."
        }
      ],
