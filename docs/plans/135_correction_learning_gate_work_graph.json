      "acceptance": [
        {
          "id": "CLG01-A1",
          "criterion": "A structured classifier detects the canonical correction while rejecting scope changes and ambiguous cases as enforcement-positive.",
          "evidence_required": [
            "Labeled both-sign fixture results",
            "Authentic traced llm_client execution within budget"
          ],
          "negative_control": "No regex or substring check infers whether user prose is a correction."
        },
        {
          "id": "CLG01-A2",
          "criterion": "Only an immutable learning recorded after the correction with the same native session source_ref resolves the receipt.",
          "evidence_required": [
            "Same-session resolution test",
            "Older and other-session rejection tests"
          ],
          "negative_control": "A final-report claim or unrelated learning cannot satisfy the gate."
        },
        {
          "id": "CLG01-A3",
          "criterion": "Observe mode cannot block and block mode reads validated receipts without model or transcript work on Stop.",
          "evidence_required": [
            "Native-shaped Stop both-sign replay",
            "Measured Stop latency",
            "Model-failure non-blocking test"
          ],
          "negative_control": "Classifier latency, route failure, or missing transcript never interrupts an agent turn."
        },
        {
          "id": "CLG01-A4",
          "criterion": "Codex and Claude Code each produce a verified native observe receipt before any blocking host promotion.",
          "evidence_required": [
            "Codex native receipt and trace",
            "Claude Code native receipt and trace",
            "Installed hook liveness output"
          ],
          "negative_control": "Source tests alone cannot establish native adoption."
        }
      ],
