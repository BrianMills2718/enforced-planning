      "title": "Build and canary the correction-aware learning gate",
      "class": "implementation",
      "objective": "Carry one user correction from a native transcript through structured model classification, same-session immutable learning reconciliation, a content-minimized receipt, and deterministic Stop verification without putting model work on the Stop hot path.",
      "profile": "standard",
      "execution_class": "independently_executable",
      "claimability": "unavailable_active_claim",
      "scope": {
        "included": [
          "Typed Codex and Claude transcript extraction",
          "Structured correction classification through llm_client",
          "Same-session Project Meta learning reconciliation",
          "Observe and block modes with both-sign tests",
          "Native observe canaries and reproducible hook wiring"
        ],
        "excluded": [
          "A parallel learning or feedback store",
          "Semantic prose matching with regex",
          "Model calls on the Stop hot path",
          "OpenClaw block-mode activation without its own transcript canary",
          "Deployment or package publication"
        ]
      },
