        {
          "id": "CBOG01-A1",
          "criterion": "Review readiness requires every frozen criterion to carry discriminating independent evidence on the exact candidate artifact digest.",
          "evidence_required": [
            "Focused both-sign source tests",
            "Missing-criterion and producer-self-verification negative controls"
          ],
          "negative_control": "A partial result, self-verification, or evidence from a different artifact cannot become review-ready."
        },
        {
          "id": "CBOG01-A2",
          "criterion": "A rejected artifact digest remains ineligible throughout the outcome lineage.",
          "evidence_required": [
            "Reject-after-pass transition test",
            "Attempted rejected-artifact revival test"
          ],
          "negative_control": "Attaching new passing prose or evidence cannot revive an exact rejected digest."
        },
        {
          "id": "CBOG01-A3",
          "criterion": "The real Plan 52 browser journey first rejects the known wrong artifact and admits only a corrected artifact satisfying both separate-map and top-to-bottom graph criteria.",
          "evidence_required": [
            "Exact local browser commands and artifact digests",
            "Independent criterion receipt",
            "Deterministic review-readiness decision"
          ],
          "negative_control": "Repository inventory, page labels, or unit-test presence cannot substitute for the rendered graph topology."
