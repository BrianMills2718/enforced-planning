#!/bin/bash
# Post-commit hook (portable enforced-planning template)
# Cleans up ephemeral coupling acknowledgements and reminds about unpushed commits.

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Acknowledgements authorize one staged commit only. The resulting commit and
# hook output retain the durable evidence; leaving the file behind could
# accidentally acknowledge a later, unrelated change.
if [[ -f "$REPO_ROOT/.doc-coupling-acks" ]]; then
    rm "$REPO_ROOT/.doc-coupling-acks"
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
REMOTE="origin/$BRANCH"

if git rev-parse --verify "$REMOTE" >/dev/null 2>&1; then
    UNPUSHED=$(git rev-list "$REMOTE..HEAD" --count 2>/dev/null || echo "0")
    if [ "$UNPUSHED" -gt 0 ]; then
        echo ""
        echo "📤 $UNPUSHED unpushed commit(s) on $BRANCH"
        echo "   Run: git push origin $BRANCH"
    fi
else
    echo ""
    echo "📤 Branch $BRANCH not yet on remote"
    echo "   Run: git push -u origin $BRANCH"
fi
