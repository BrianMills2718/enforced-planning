#!/bin/bash
# Pre-commit hook (portable enforced-planning template)
# Each check only runs if its script is installed.
# Install via: ./install.sh

set -e

HOOK_MODE="${ENFORCED_PLANNING_HOOK_MODE:-warn}"
case "$HOOK_MODE" in
    off|warn|block) ;;
    *)
        echo "ERROR: ENFORCED_PLANNING_HOOK_MODE must be off, warn, or block; got '$HOOK_MODE'."
        exit 2
        ;;
esac

echo "Running pre-commit checks (mode: $HOOK_MODE)..."

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# --- Canonical-checkout guard -------------------------------------------------
# Implementation belongs in a claimed worktree at <repo>/worktrees/<branch>/,
# never the canonical checkout. Only two of 88 active governed repositories
# enforced that on 2026-08-21, both hand-edited, because this template did not
# carry the check and so no repository ever received it by installation.
#
# On that day two sessions worked one canonical checkout at once. A finished,
# verified edit vanished leaving a clean `git status`, and another session's
# unfinished work came within one command of being committed by the wrong
# agent, twice. The repositories that already had this guard are the ones where
# nothing went wrong.
#
# The pre-write claim gate cannot cover this. It is wired to PreToolUse on
# Edit|Write, and bypass-permissions mode instructs agents to change files with
# sed and heredocs instead, so shell writes never reach it. A commit-time check
# sees every write regardless of how it was made.
#
# This check deliberately blocks in warn mode, unlike every other check below.
# Prose already said to use a worktree and was ignored; a warning here would
# reproduce the failure it exists to prevent. HOOK_MODE=off still disables it,
# and ALLOW_CANONICAL_CHECKOUT_COMMIT=1 skips only this check while the rest of
# the suite still runs -- unlike --no-verify, which skips everything.
#
# Detect canonical vs. linked worktree by comparing --git-common-dir (always the
# main repo's .git) with --git-dir (the same path in the canonical checkout, but
# .git/worktrees/<name> in a linked worktree); equal means canonical. Both need
# --path-format=absolute: from a subdirectory, plain --git-common-dir returns a
# relative path while --git-dir returns absolute, so an unnormalized compare is
# always unequal and the guard silently never fires.
if [[ "$HOOK_MODE" != "off" && "${ALLOW_CANONICAL_CHECKOUT_COMMIT:-0}" != "1" ]]; then
    GIT_COMMON_DIR_ABS=$(git rev-parse --path-format=absolute --git-common-dir)
    GIT_DIR_ABS=$(git rev-parse --path-format=absolute --git-dir)
    if [[ "$GIT_COMMON_DIR_ABS" == "$GIT_DIR_ABS" ]]; then
        echo ""
        echo "ERROR: Commit blocked - this is the CANONICAL checkout, not a worktree."
        echo "Implementation belongs in a claimed worktree at worktrees/<branch>/."
        echo ""
        echo "Fix - prefer the repository entry point, which also registers a claim:"
        echo "  make worktree BRANCH=<name> TASK=\"...\"    # if this repo has it"
        echo "  git worktree add worktrees/<name> -b <name>  # otherwise"
        echo "  cd worktrees/<name>   # re-stage and commit there"
        echo ""
        echo "Escape hatch (reversible single-writer maintenance only):"
        echo "  ALLOW_CANONICAL_CHECKOUT_COMMIT=1 git commit ..."
        echo ""
        exit 1
    fi
fi
# --- end canonical-checkout guard ---------------------------------------------

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

# Helper: find a script at either scripts/ or scripts/meta/.
# scripts/ is checked first: in this source repo it is the canonical
# location, and scripts/meta/ may hold a stale self-installed copy that
# silently shadows it otherwise (the same find_script() shadowing-bug class
# documented in ACCRETION_DETECTOR_ROLLOUT_BRIEF.md's rollout notes).
find_script() {
    local name="$1"
    if [[ -f "$REPO_ROOT/scripts/$name" ]]; then
        echo "$REPO_ROOT/scripts/$name"
    elif [[ -f "$REPO_ROOT/scripts/meta/$name" ]]; then
        echo "$REPO_ROOT/scripts/meta/$name"
    fi
}

handle_failure() {
    local check_name="$1"
    if [[ "$HOOK_MODE" == "block" ]]; then
        echo "ERROR: $check_name failed in explicit block mode."
        return 1
    fi
    echo "WARNING: $check_name failed; commit continues in warn mode."
    echo "Set ENFORCED_PLANNING_HOOK_MODE=block for a strict pilot/release candidate."
    return 0
}

# 0. Immutable terminal-verification batch check (if installed)
VERIFICATION_BATCH=$(find_script "verification_batch.py")
if [[ -n "$VERIFICATION_BATCH" ]]; then
    echo "Checking verification batch freeze..."
    if ! python "$VERIFICATION_BATCH" --repo-root "$REPO_ROOT" check; then
        echo ""
        echo "ERROR: This branch is frozen for exact terminal verification."
        echo "Queue unrelated work in the next batch. For a blocker in the frozen"
        echo "scope, run verification-batch-thaw with a recorded reason first."
        echo ""
        exit 1
    fi
fi

if [[ "$HOOK_MODE" == "off" ]]; then
    echo "Governance checks disabled for this reversible commit."
    exit 0
fi

# 1. New-artifact creation and directory policy (when explicitly configured)
ARTIFACT_CREATION=$(find_script "artifact_creation.py")
if [[ -n "$ARTIFACT_CREATION" ]]; then
    echo "Checking newly staged artifact creation policy..."
    if ! python "$ARTIFACT_CREATION" check --repo-root "$REPO_ROOT"; then
        echo ""
        echo "New tracked artifact violates the configured directory or intent policy."
        echo "Run 'python $ARTIFACT_CREATION check --repo-root $REPO_ROOT --json' for details."
        echo ""
        handle_failure "artifact creation policy" || exit 1
    fi
fi

# 2. Locked-coupling check (V2 relationships.yaml)
LOCKED_COUPLINGS=$(find_script "check_locked_couplings.py")
if [[ -n "$LOCKED_COUPLINGS" ]]; then
    echo "Checking locked couplings..."
    if ! python "$LOCKED_COUPLINGS" --strict; then
        echo ""
        echo "Locked coupling finding: update a coupled document only when its"
        echo "named decision or contract actually changed."
        echo "Run 'python $LOCKED_COUPLINGS' to see violations."
        echo ""
        handle_failure "locked coupling check" || exit 1
    fi
fi

# 3. Doc-coupling check (if script exists)
DOC_COUPLING=$(find_script "check_doc_coupling.py")
if [[ -n "$DOC_COUPLING" ]]; then
    echo "Checking doc-code coupling..."
    DOC_COUPLING_ARGS=(--staged --strict)
    if [[ -f "$REPO_ROOT/.doc-coupling-acks" ]]; then
        DOC_COUPLING_ARGS+=(--ack-file "$REPO_ROOT/.doc-coupling-acks")
    fi
    if ! python "$DOC_COUPLING" "${DOC_COUPLING_ARGS[@]}"; then
        echo ""
        echo "Doc-coupling finding detected."
        echo "Run 'python $DOC_COUPLING --suggest' to see which docs to update."
        echo "Or create .doc-coupling-acks with a reason for each unchanged authority."
        echo ""
        handle_failure "doc-coupling check" || exit 1
    fi
fi

# 4. Module-reachability ratchet (if script exists). REACHABILITY_RATCHET=off
# is a named, logged bypass for the first tuning pass on a repo -- see
# ACCRETION_DETECTOR_ROLLOUT_BRIEF.md section 10a.
REACHABILITY=$(find_script "check_reachability.py")
if [[ -n "$REACHABILITY" ]] && [[ "${REACHABILITY_RATCHET:-on}" != "off" ]]; then
    echo "Checking module reachability..."
    if ! python "$REACHABILITY" --project-root "$REPO_ROOT" --check; then
        echo ""
        echo "Reachability regression: a module became unreachable from every"
        echo "declared entrypoint since the baseline."
        echo "Wire it to an entrypoint, delete it, or add it to"
        echo "quality.reachability.dynamic in meta-process.yaml with a comment"
        echo "saying why it's only reached by string import."
        echo "Bypass once with REACHABILITY_RATCHET=off git commit ... (logged, narrow)."
        echo ""
        handle_failure "reachability ratchet" || exit 1
    fi
elif [[ -n "$REACHABILITY" ]]; then
    echo "Reachability ratchet bypassed via REACHABILITY_RATCHET=off."
fi

# 5. Mypy on changed src/ files (if mypy is installed)
STAGED_SRC=$(echo "$STAGED_PY" | grep '^src/' || true)
if [[ -n "$STAGED_SRC" ]] && command -v mypy >/dev/null 2>&1; then
    echo "Running mypy on changed files..."
    if ! python -m mypy --strict --ignore-missing-imports --follow-imports=silent $STAGED_SRC; then
        echo ""
        echo "Mypy type check failed."
        echo ""
        handle_failure "mypy check" || exit 1
    fi
fi

# 6. Capabilities section check on staged plan files
CHECK_CAPS=$(find_script "check_plan_capabilities.py")
if [[ -n "$CHECK_CAPS" ]]; then
    STAGED_PLAN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/.*\.md$' || true)
    if [[ -n "$STAGED_PLAN_FILES" ]]; then
        echo "Checking plan Capabilities sections..."
        if ! python "$CHECK_CAPS" $STAGED_PLAN_FILES --strict 2>/dev/null; then
            echo ""
            echo "ERROR: Cross-project plan missing Capabilities section!"
            echo "Run 'python $CHECK_CAPS docs/plans/' to see all warnings."
            echo ""
            handle_failure "plan capabilities check" || exit 1
        fi
    fi
fi

# 7. Plan status consistency (if script exists and plan files staged)
SYNC_STATUS=$(find_script "sync_plan_status.py")
if [[ -n "$SYNC_STATUS" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Checking plan status consistency..."
        if ! python "$SYNC_STATUS" --check 2>/dev/null; then
            echo ""
            echo "ERROR: Plan status inconsistency detected!"
            echo "Run 'python $SYNC_STATUS --check' to see details"
            echo ""
            handle_failure "plan status check" || exit 1
        fi
    fi
fi

# 8. Dead code check (the script itself honors meta-process.yaml enablement)
DEAD_CODE=$(find_script "check_dead_code.py")
if [[ -n "$DEAD_CODE" ]] && [[ -n "$STAGED_PY" ]]; then
    echo "Checking for dead code..."
    if ! python "$DEAD_CODE"; then
        echo ""
        echo "Dead code check failed."
        echo "Run 'python $DEAD_CODE' to see details."
        echo ""
        handle_failure "dead code check" || exit 1
    fi
fi

# 9. Branch divergence advisory against the existing local remote ref.
# Network freshness belongs at push/release time, not in a local commit hook.
echo "Checking cached branch divergence..."
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || true
REMOTE="origin/$BRANCH"

if git rev-parse --verify "$REMOTE" >/dev/null 2>&1; then
    LOCAL_ONLY=$(git rev-list "$REMOTE..HEAD" --count 2>/dev/null || echo "0")
    REMOTE_ONLY=$(git rev-list "HEAD..$REMOTE" --count 2>/dev/null || echo "0")

    if [ "$REMOTE_ONLY" -gt 0 ] && [ "$LOCAL_ONLY" -gt 0 ]; then
        echo ""
        echo "WARNING: Branch has diverged from the cached remote ref."
        echo "  Local commits not on remote: $LOCAL_ONLY"
        echo "  Remote commits not local: $REMOTE_ONLY"
        echo "Reconcile before push; local commit remains recoverable."
    fi

    if [ "$REMOTE_ONLY" -gt 5 ]; then
        echo "WARNING: Branch is $REMOTE_ONLY commits behind remote"
        echo "Consider: git pull --rebase origin $BRANCH"
    fi
fi

# 10. Terminology linter on staged .md files (if vocab pack and script exist)
TERM_LINTER=$(find_script "check_terminology.py")
VOCAB_PACK="$REPO_ROOT/generated/vocab_pack.jsonl"
if [[ -n "$TERM_LINTER" ]] && [[ -f "$VOCAB_PACK" ]]; then
    STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' | grep -v '^vision/archive/' | grep -v '^docs/ops/archive/' | grep -v '^tests/fixtures/' || true)
    if [[ -n "$STAGED_MD" ]]; then
        echo "Checking terminology in staged markdown files..."
        if ! python "$TERM_LINTER" --files $STAGED_MD 2>/dev/null; then
            echo ""
            echo "ERROR: Deprecated terminology found in staged files!"
            echo "Run 'python $TERM_LINTER --files <file>' to see violations."
            echo ""
            handle_failure "terminology check" || exit 1
        fi
    fi
fi

# 11. Topic-tag vocabulary gate and view regeneration (if installed).
# A `Topics:` tag in a module docstring must resolve against
# docs/topics/registry.yaml. Free-text tags fragment into near-duplicates and
# the aggregated view silently stops being one view -- the same pattern applied
# to entity identity in this ecosystem produced 4,226 ids for 190 distinct
# people. Commit time is the only point where the author still knows whether an
# unknown tag is a typo or a genuinely new topic. Regenerating on the way
# through is what makes a topic page a projection of the code rather than an
# artifact somebody has to remember to refresh.
TOPIC_VIEWS=$(find_script "topic_views.py")
if [[ -n "$TOPIC_VIEWS" ]] && [[ -f "$REPO_ROOT/docs/topics/registry.yaml" ]]; then
    echo "Checking topic tags..."
    if ! "$PYTHON" "$TOPIC_VIEWS" --root "$REPO_ROOT" --check --write >/dev/null; then
        echo ""
        echo "ERROR: undeclared topic tag."
        "$PYTHON" "$TOPIC_VIEWS" --root "$REPO_ROOT" --check >/dev/null || true
        echo "Declare it in docs/topics/registry.yaml with a one-sentence"
        echo "definition, or fix the tag."
        echo ""
        handle_failure "topic tag check" || exit 1
    fi
    if ! git diff --quiet -- docs/topics/views 2>/dev/null; then
        git add docs/topics/views
        echo "  topic views regenerated and staged"
    fi
fi

echo "Pre-commit checks passed!"
