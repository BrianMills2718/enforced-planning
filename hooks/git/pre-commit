#!/bin/bash
# Pre-commit hook (portable enforced-planning template)
# Each check only runs if its script is installed.
# Install via: ./install.sh

set -e

if [[ -n "${PYTHON_BIN:-}" ]]; then
    :
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN=python
else
    echo "ERROR: pre-commit checks require Python 3, but no interpreter was found."
    exit 1
fi

HOOK_MODE="${ENFORCED_PLANNING_HOOK_MODE:-warn}"
case "$HOOK_MODE" in
    off|warn|block) ;;
    *)
        echo "ERROR: ENFORCED_PLANNING_HOOK_MODE must be off, warn, or block; got '$HOOK_MODE'."
        exit 2
        ;;
esac

echo "Running pre-commit checks (mode: $HOOK_MODE)..."

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# --- Canonical-checkout guard -------------------------------------------------
# Implementation belongs in a claimed worktree at <repo>/worktrees/<branch>/,
# never the canonical checkout. Only two of 88 active governed repositories
# enforced that on 2026-08-21, both hand-edited, because this template did not
# carry the check and so no repository ever received it by installation.
#
# On that day two sessions worked one canonical checkout at once. A finished,
# verified edit vanished leaving a clean `git status`, and another session's
# unfinished work came within one command of being committed by the wrong
# agent, twice. The repositories that already had this guard are the ones where
# nothing went wrong.
#
# The pre-write claim gate cannot cover this. It is wired to PreToolUse on
# Edit|Write, and bypass-permissions mode instructs agents to change files with
# sed and heredocs instead, so shell writes never reach it. A commit-time check
# sees every write regardless of how it was made.
#
# This check deliberately blocks in warn mode, unlike every other check below.
# Prose already said to use a worktree and was ignored; a warning here would
# reproduce the failure it exists to prevent. HOOK_MODE=off still disables it,
# and ALLOW_CANONICAL_CHECKOUT_COMMIT=1 skips only this check while the rest of
# the suite still runs -- unlike --no-verify, which skips everything.
#
# The escape hatch reintroduced the weakness the paragraph above warns about.
# On 2026-08-23 one session set ALLOW_CANONICAL_CHECKOUT_COMMIT six times
# across two repositories rather than create one worktree, because the hatch
# was free: one variable prefixed onto the command already typed, versus a
# five-blank `make maintenance-worktree`; nothing counted repeat use, so every
# use looked like the first; and the first one succeeded, so nothing signalled
# it was the worse path. The hatch is therefore metered per repository per
# session -- 1st use quiet, 2nd loud, 3rd refused -- and the cost of the
# correct path was cut to one argument in the same change.
#
# The ledger lives in this repository's own Git common directory rather than
# under $HOME: that keys it by repository for free, is never tracked or
# committed, is shared by every linked worktree of the clone, and disappears
# when the clone does. Session identity comes from the agent runtime's session
# id; with no runtime id it falls back to a per-UTC-day bucket, which
# over-counts rather than under-counts -- the safe direction for a guard.
#
# Detect canonical vs. linked worktree by comparing --git-common-dir (always the
# main repo's .git) with --git-dir (the same path in the canonical checkout, but
# .git/worktrees/<name> in a linked worktree); equal means canonical. Both need
# --path-format=absolute: from a subdirectory, plain --git-common-dir returns a
# relative path while --git-dir returns absolute, so an unnormalized compare is
# always unequal and the guard silently never fires.
if [[ "$HOOK_MODE" != "off" ]]; then
    GIT_COMMON_DIR_ABS=$(git rev-parse --path-format=absolute --git-common-dir)
    GIT_DIR_ABS=$(git rev-parse --path-format=absolute --git-dir)
    if [[ "$GIT_COMMON_DIR_ABS" == "$GIT_DIR_ABS" ]]; then

        # The exact command for THIS repository, so the remedy needs no lookup.
        # Repos that require a scoped write claim reject a bare BRANCH=, so name
        # SESSION_WRITE_PATHS only where the Makefile actually demands it.
        if [[ -f "$REPO_ROOT/Makefile" ]] && grep -q '^maintenance-worktree:' "$REPO_ROOT/Makefile"; then
            WORKTREE_CMD="  make maintenance-worktree BRANCH=<name>"
            if grep -q -- '--require-write-claim' "$REPO_ROOT/Makefile"; then
                WORKTREE_CMD="$WORKTREE_CMD SESSION_WRITE_PATHS=\"<paths you will edit>\""
            fi
        elif [[ -f "$REPO_ROOT/Makefile" ]] && grep -q '^worktree:' "$REPO_ROOT/Makefile"; then
            WORKTREE_CMD="  make worktree BRANCH=<name> TASK=\"...\" SESSION_GOAL=\"...\" SESSION_PHASE=\"...\""
        else
            WORKTREE_CMD="  git worktree add worktrees/<name> -b <name>"
        fi

        if [[ "${ALLOW_CANONICAL_CHECKOUT_COMMIT:-0}" != "1" ]]; then
            echo ""
            echo "ERROR: Commit blocked - this is the CANONICAL checkout, not a worktree."
            echo "Implementation belongs in a claimed worktree at worktrees/<branch>/."
            echo ""
            echo "Fix - prefer the repository entry point, which also registers a claim:"
            echo "$WORKTREE_CMD"
            echo "  cd worktrees/<name>   # re-stage and commit there"
            echo ""
            echo "Escape hatch (reversible single-writer maintenance only). It is"
            echo "metered: 2nd use in this repository this session warns, 3rd is refused."
            echo "  ALLOW_CANONICAL_CHECKOUT_COMMIT=1 git commit ..."
            echo ""
            exit 1
        fi

        # --- the hatch was taken: meter it ------------------------------------
        HATCH_SESSION="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-${CODEX_THREAD_ID:-${OPENCLAW_SESSION_ID:-}}}}"
        if [[ -z "$HATCH_SESSION" ]]; then
            HATCH_SESSION="nosession-$(date -u +%Y%m%d)"
        fi
        HATCH_SESSION="${HATCH_SESSION//[^A-Za-z0-9._-]/_}"
        HATCH_LEDGER="$GIT_COMMON_DIR_ABS/canonical-checkout-hatch-uses"
        HATCH_OVERRIDE="${CANONICAL_CHECKOUT_HATCH_OVERRIDE:-}"
        HATCH_OVERRIDE="${HATCH_OVERRIDE//[$'\t\n']/ }"

        # Tried and removed 2026-08-23, same day it was added. The idea was to
        # refuse the hatch when every staged path sits under a directory many
        # sessions append to (project-meta's learnings/entries/), because
        # "reversible single-writer maintenance" is a precondition an agent can
        # satisfy by believing it. It refused the one commit shape that is
        # actually safe. scripts/_register_commit.py commits register entries
        # with `git commit -- <one unique new file>`; a pathspec commit builds
        # its own index from HEAD plus that path, so the hook sees only that
        # file and the commit provably cannot sweep another writer's staged
        # work. Verified: with another session's file staged, the hook saw only
        # the register entry. The rule therefore broke that script's documented
        # recovery command while protecting nothing, and 14 register entries had
        # already been lost to stranding once. Rewriting existing entries is
        # separately blocked by the append-only check. Do not re-add this
        # without a commit shape that can actually collide.

        HATCH_PRIOR=0
        if [[ -f "$HATCH_LEDGER" ]]; then
            HATCH_KEY=$'\t'"$HATCH_SESSION"$'\t'
            HATCH_PRIOR=$(grep -c -F "$HATCH_KEY" "$HATCH_LEDGER" 2>/dev/null || true)
        fi
        HATCH_COUNT=$(( ${HATCH_PRIOR:-0} + 1 ))

        HATCH_REFUSE_REASON=""
        if [[ "$HATCH_COUNT" -ge 3 ]]; then
            HATCH_REFUSE_REASON="this is hatch use #$HATCH_COUNT for this repository in this session; #2 already warned that #3 would be refused"
        fi

        if [[ -n "$HATCH_REFUSE_REASON" && -z "$HATCH_OVERRIDE" ]]; then
            echo ""
            echo "ERROR: canonical-checkout escape hatch REFUSED."
            echo "Reason: $HATCH_REFUSE_REASON"
            echo ""
            echo "Fix - make the worktree once. It is one command, then commit there:"
            echo "$WORKTREE_CMD"
            echo "  cd worktrees/<name>   # re-stage and commit there"
            echo ""
            echo "Genuine emergency, recorded with your reason in"
            echo "$HATCH_LEDGER :"
            echo "  ALLOW_CANONICAL_CHECKOUT_COMMIT=1 \\"
            echo "    CANONICAL_CHECKOUT_HATCH_OVERRIDE=\"why a worktree is impossible now\" \\"
            echo "    git commit ..."
            echo ""
            echo "Or disable the whole check suite for one reversible commit:"
            echo "  ENFORCED_PLANNING_HOOK_MODE=off git commit ..."
            echo ""
            exit 1
        fi

        # Record before allowing, so the next commit sees this one. A ledger that
        # cannot be written is loud rather than silent: escalation stops counting,
        # and refusing the commit over an unwritable counter file would be worse.
        if ! printf '%s\t%s\t%s\t%s\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                "$HATCH_SESSION" \
                "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')" \
                "$HATCH_OVERRIDE" >> "$HATCH_LEDGER" 2>/dev/null; then
            echo "WARNING: could not write $HATCH_LEDGER; this hatch use is NOT counted."
        fi

        if [[ -n "$HATCH_OVERRIDE" ]]; then
            echo ""
            echo "Canonical-checkout hatch OVERRIDE, use #$HATCH_COUNT this session."
            echo "Recorded reason: $HATCH_OVERRIDE"
            echo ""
        elif [[ "$HATCH_COUNT" -ge 2 ]]; then
            echo ""
            echo "WARNING: canonical-checkout escape hatch, use #$HATCH_COUNT for this"
            echo "repository in this session. THE NEXT USE IS REFUSED."
            echo "The hatch is for one exception; you are using it as a workflow."
            echo "Make the worktree now - one command, and it registers the claim:"
            echo "$WORKTREE_CMD"
            echo "  cd worktrees/<name>   # re-stage and commit there"
            echo ""
        else
            echo "Canonical-checkout guard bypassed (hatch use #1 this session, recorded)."
        fi
    fi
fi
# --- end canonical-checkout guard ---------------------------------------------

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

# Helper: find a script at either scripts/ or scripts/meta/.
# scripts/ is checked first: in this source repo it is the canonical
# location, and scripts/meta/ may hold a stale self-installed copy that
# silently shadows it otherwise (the same find_script() shadowing-bug class
# documented in ACCRETION_DETECTOR_ROLLOUT_BRIEF.md's rollout notes).
find_script() {
    local name="$1"
    if [[ -f "$REPO_ROOT/scripts/$name" ]]; then
        echo "$REPO_ROOT/scripts/$name"
    elif [[ -f "$REPO_ROOT/scripts/meta/$name" ]]; then
        echo "$REPO_ROOT/scripts/meta/$name"
    fi
}

# Per-check mode, falling back to the global HOOK_MODE.
#
# One global switch meant a repo could not make a check that works blocking
# while a check that is merely unavailable stays advisory. Measured here on
# 2026-08-24: doc-coupling correctly detected a staged source change whose
# coupled document was untouched, named the exact documents, and exited 1 --
# and the commit landed anyway, because the dead-code check needs `vulture`
# which is not installed, so nobody could turn the global switch to block.
# A repo declares blocking checks in meta-process.yaml:
#
#   quality:
#     hook_modes:
#       doc-coupling check: block
#
# The key is the check name passed to handle_failure.
check_mode() {
    local check_name="$1"
    local declared
    declared=$("$PYTHON_BIN" - "$REPO_ROOT" "$check_name" <<'PYEOF' 2>/dev/null || true
import sys
try:
    import yaml
except Exception:
    raise SystemExit(0)
from pathlib import Path
root, name = Path(sys.argv[1]), sys.argv[2]
cfg = root / "meta-process.yaml"
if not cfg.exists():
    raise SystemExit(0)
try:
    data = yaml.safe_load(cfg.read_text()) or {}
except Exception:
    raise SystemExit(0)
# Governed repos nest config under `meta_process:`; some do not. Accept both
# rather than silently reading an empty dict, which would make every declared
# blocking check quietly advisory -- the exact failure this option exists to fix.
root_map = data.get("meta_process") if isinstance(data.get("meta_process"), dict) else data
modes = ((root_map.get("quality") or {}).get("hook_modes") or {})
value = modes.get(name)
if isinstance(value, str) and value in {"off", "warn", "block"}:
    print(value)
PYEOF
)
    if [[ -n "$declared" ]]; then
        echo "$declared"
    else
        echo "$HOOK_MODE"
    fi
}

WARNED_CHECKS=()

handle_failure() {
    local check_name="$1"
    local mode
    mode=$(check_mode "$check_name")
    if [[ "$mode" == "block" ]]; then
        if [[ "$mode" != "$HOOK_MODE" ]]; then
            echo "ERROR: $check_name failed, and this repository declares it blocking"
            echo "       in meta-process.yaml (quality.hook_modes)."
        else
            echo "ERROR: $check_name failed in explicit block mode."
        fi
        return 1
    fi
    WARNED_CHECKS+=("$check_name")
    echo "WARNING: $check_name failed; commit continues in warn mode."
    echo "Set ENFORCED_PLANNING_HOOK_MODE=block for a strict pilot/release candidate,"
    echo "or declare this one check blocking under quality.hook_modes in meta-process.yaml."
    return 0
}

# 0. Immutable terminal-verification batch check (if installed)
VERIFICATION_BATCH=$(find_script "verification_batch.py")
if [[ -n "$VERIFICATION_BATCH" ]]; then
    echo "Checking verification batch freeze..."
    if ! "$PYTHON_BIN" "$VERIFICATION_BATCH" --repo-root "$REPO_ROOT" check; then
        echo ""
        echo "ERROR: This branch is frozen for exact terminal verification."
        echo "Queue unrelated work in the next batch. For a blocker in the frozen"
        echo "scope, run verification-batch-thaw with a recorded reason first."
        echo ""
        exit 1
    fi
fi

if [[ "$HOOK_MODE" == "off" ]]; then
    echo "Governance checks disabled for this reversible commit."
    exit 0
fi

# 1. New-artifact creation and directory policy (when explicitly configured)
ARTIFACT_CREATION=$(find_script "artifact_creation.py")
if [[ -n "$ARTIFACT_CREATION" ]]; then
    echo "Checking newly staged artifact creation policy..."
    if ! "$PYTHON_BIN" "$ARTIFACT_CREATION" check --repo-root "$REPO_ROOT"; then
        echo ""
        echo "New tracked artifact violates the configured directory or intent policy."
        echo "Run 'python $ARTIFACT_CREATION check --repo-root $REPO_ROOT --json' for details."
        echo ""
        handle_failure "artifact creation policy" || exit 1
    fi
fi

# 2. Locked-coupling check (V2 relationships.yaml)
LOCKED_COUPLINGS=$(find_script "check_locked_couplings.py")
if [[ -n "$LOCKED_COUPLINGS" ]]; then
    echo "Checking locked couplings..."
    if ! "$PYTHON_BIN" "$LOCKED_COUPLINGS" --strict; then
        echo ""
        echo "Locked coupling finding: update a coupled document only when its"
        echo "named decision or contract actually changed."
        echo "Run 'python $LOCKED_COUPLINGS' to see violations."
        echo ""
        handle_failure "locked coupling check" || exit 1
    fi
fi

# 3. Doc-coupling check (if script exists)
DOC_COUPLING=$(find_script "check_doc_coupling.py")
if [[ -n "$DOC_COUPLING" ]]; then
    echo "Checking doc-code coupling..."
    DOC_COUPLING_ARGS=(--staged --strict)
    if [[ -f "$REPO_ROOT/.doc-coupling-acks" ]]; then
        DOC_COUPLING_ARGS+=(--ack-file "$REPO_ROOT/.doc-coupling-acks")
    fi
    if ! "$PYTHON_BIN" "$DOC_COUPLING" "${DOC_COUPLING_ARGS[@]}"; then
        echo ""
        echo "Doc-coupling finding detected."
        echo "Run 'python $DOC_COUPLING --suggest' to see which docs to update."
        echo "Or create .doc-coupling-acks with a reason for each unchanged authority."
        echo ""
        handle_failure "doc-coupling check" || exit 1
    fi
fi

# Coupling acknowledgements are one-commit scratch state. The hook may read the
# file above, but it must never become part of the candidate tree: a squash
# merge can otherwise resurrect the file even though post-commit removed the
# local working copy. A staged deletion is allowed because git ls-files reads
# the candidate index, where the path is already absent.
if git ls-files --error-unmatch -- .doc-coupling-acks >/dev/null 2>&1; then
    echo ""
    echo ".doc-coupling-acks is ephemeral but is tracked in the candidate commit."
    echo "Keep the working copy, remove it from the index, and ignore it:"
    echo "  git rm --cached -- .doc-coupling-acks"
    echo "  add .doc-coupling-acks to .gitignore"
    exit 1
fi

# 4. Module-reachability ratchet (if script exists). REACHABILITY_RATCHET=off
# is a named, logged bypass for the first tuning pass on a repo -- see
# ACCRETION_DETECTOR_ROLLOUT_BRIEF.md section 10a.
REACHABILITY=$(find_script "check_reachability.py")
if [[ -n "$REACHABILITY" ]] && [[ "${REACHABILITY_RATCHET:-on}" != "off" ]]; then
    echo "Checking module reachability..."
    if ! "$PYTHON_BIN" "$REACHABILITY" --project-root "$REPO_ROOT" --check; then
        echo ""
        echo "Reachability regression: a module became unreachable from every"
        echo "declared entrypoint since the baseline."
        echo "Wire it to an entrypoint, delete it, or add it to"
        echo "quality.reachability.dynamic in meta-process.yaml with a comment"
        echo "saying why it's only reached by string import."
        echo "Bypass once with REACHABILITY_RATCHET=off git commit ... (logged, narrow)."
        echo ""
        handle_failure "reachability ratchet" || exit 1
    fi
elif [[ -n "$REACHABILITY" ]]; then
    echo "Reachability ratchet bypassed via REACHABILITY_RATCHET=off."
fi

# 5. Mypy on changed src/ files (if mypy is installed)
STAGED_SRC=$(echo "$STAGED_PY" | grep '^src/' || true)
if [[ -n "$STAGED_SRC" ]] && command -v mypy >/dev/null 2>&1; then
    echo "Running mypy on changed files..."
    if ! "$PYTHON_BIN" -m mypy --strict --ignore-missing-imports --follow-imports=silent $STAGED_SRC; then
        echo ""
        echo "Mypy type check failed."
        echo ""
        handle_failure "mypy check" || exit 1
    fi
fi

# 6. Capabilities section check on staged plan files
CHECK_CAPS=$(find_script "check_plan_capabilities.py")
if [[ -n "$CHECK_CAPS" ]]; then
    STAGED_PLAN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/.*\.md$' || true)
    if [[ -n "$STAGED_PLAN_FILES" ]]; then
        echo "Checking plan Capabilities sections..."
        if ! "$PYTHON_BIN" "$CHECK_CAPS" $STAGED_PLAN_FILES --strict 2>/dev/null; then
            echo ""
            echo "ERROR: Cross-project plan missing Capabilities section!"
            echo "Run 'python $CHECK_CAPS docs/plans/' to see all warnings."
            echo ""
            handle_failure "plan capabilities check" || exit 1
        fi
    fi
fi

# 7. Plan status consistency (if script exists and plan files staged)
SYNC_STATUS=$(find_script "sync_plan_status.py")
if [[ -n "$SYNC_STATUS" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Checking plan status consistency..."
        if ! "$PYTHON_BIN" "$SYNC_STATUS" --check 2>/dev/null; then
            echo ""
            echo "ERROR: Plan status inconsistency detected!"
            echo "Run 'python $SYNC_STATUS --check' to see details"
            echo ""
            handle_failure "plan status check" || exit 1
        fi
    fi
fi

# 7b. Plan status transition guard (if script exists and plan files staged)
# A plan with a terminal status is excluded from the generated active-plan
# queue, so marking one Complete removes it from the context every agent loads
# at session start. Observed in project-meta on 2026-09-08: a governed commit
# left a plan marked Complete in the working tree with its actual outcome
# still missing, and the writer was never identified; only the pre-push
# dirty-tree gate caught it. This guards the outcome rather than the route: a
# terminal status must arrive with the evidence block complete_plan.py writes.
STATUS_TRANSITIONS=$(find_script "check_plan_status_transitions.py")
if [[ -n "$STATUS_TRANSITIONS" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Checking plan status transitions..."
        if ! "$PYTHON_BIN" "$STATUS_TRANSITIONS" --mode staged; then
            echo ""
            echo "ERROR: Plan status transition check failed!"
            echo "Run 'python $STATUS_TRANSITIONS --mode staged' to see details"
            echo ""
            handle_failure "plan status transitions check" || exit 1
        fi
    fi
fi

# 8. Dead code check (the script itself honors meta-process.yaml enablement)
DEAD_CODE=$(find_script "check_dead_code.py")
if [[ -n "$DEAD_CODE" ]] && [[ -n "$STAGED_PY" ]]; then
    echo "Checking for dead code..."
    if ! "$PYTHON_BIN" "$DEAD_CODE"; then
        echo ""
        echo "Dead code check failed."
        echo "Run 'python $DEAD_CODE' to see details."
        echo ""
        handle_failure "dead code check" || exit 1
    fi
fi

# 9. Branch divergence advisory against the existing local remote ref.
# Network freshness belongs at push/release time, not in a local commit hook.
echo "Checking cached branch divergence..."
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || true
REMOTE="origin/$BRANCH"

if git rev-parse --verify "$REMOTE" >/dev/null 2>&1; then
    LOCAL_ONLY=$(git rev-list "$REMOTE..HEAD" --count 2>/dev/null || echo "0")
    REMOTE_ONLY=$(git rev-list "HEAD..$REMOTE" --count 2>/dev/null || echo "0")

    if [ "$REMOTE_ONLY" -gt 0 ] && [ "$LOCAL_ONLY" -gt 0 ]; then
        echo ""
        echo "WARNING: Branch has diverged from the cached remote ref."
        echo "  Local commits not on remote: $LOCAL_ONLY"
        echo "  Remote commits not local: $REMOTE_ONLY"
        echo "Reconcile before push; local commit remains recoverable."
    fi

    if [ "$REMOTE_ONLY" -gt 5 ]; then
        echo "WARNING: Branch is $REMOTE_ONLY commits behind remote"
        echo "Consider: git pull --rebase origin $BRANCH"
    fi
fi

# 10. Terminology linter on staged .md files (if vocab pack and script exist)
TERM_LINTER=$(find_script "check_terminology.py")
VOCAB_PACK="$REPO_ROOT/generated/vocab_pack.jsonl"
if [[ -n "$TERM_LINTER" ]] && [[ -f "$VOCAB_PACK" ]]; then
    STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' | grep -v '^vision/archive/' | grep -v '^docs/ops/archive/' | grep -v '^tests/fixtures/' || true)
    if [[ -n "$STAGED_MD" ]]; then
        echo "Checking terminology in staged markdown files..."
        if ! "$PYTHON_BIN" "$TERM_LINTER" --files $STAGED_MD 2>/dev/null; then
            echo ""
            echo "ERROR: Deprecated terminology found in staged files!"
            echo "Run 'python $TERM_LINTER --files <file>' to see violations."
            echo ""
            handle_failure "terminology check" || exit 1
        fi
    fi
fi

# 10b. No prose string-matching (policy no-prose-string-matching, if installed).
# A check that decides what a report *means* by looking for words in it cannot
# tell a claim from a receipt, so it produces false blocks and false passes at
# once and neither is visible to whoever is relying on it. Four Stop-event gates
# on this machine were switched off for that in two days, and those four are the
# only events at which anything can refuse a turn on Claude Code.
#
# Where the judgement is semantic, use a light LLM. Parsing structured output is
# allowed only where the owner approved it for that gate -- and approval is not
# finished until the producing agent is told to emit the fields, because a
# structured path nothing emits is a dead branch and the prose fallback beneath
# it hides that the branch never fires. That happened here: the learnings-status
# marker added in #391 appears in no instruction file, so nothing has ever
# emitted it.
#
# Staged Python only, like the checks around it: the rule is about the moment a
# matcher is written, and the author is the only person who still knows whether
# the text is prose or a grammar. Through handle_failure, so it reports in this
# repository's default warn mode and blocks where a repo declares it blocking --
# ten known sites live here today, in evidence_sample_hook.py, complete_plan.py
# and learning_capture_hook.py, and a check that blocked every commit touching
# them would block their repair first.
#
# --allow-vacuous is correct for a staged-file run and wrong for a sweep: the
# checker refuses to report a clean sweep over a corpus its vocabulary never
# touched, but one staged file with no prose in it is ordinary.
PROSE_CHECK=$(find_script "check_no_prose_string_matching.py")
if [[ -n "$PROSE_CHECK" ]]; then
    STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
    if [[ -n "$STAGED_PY" ]]; then
        echo "Checking for prose string-matching..."
        # shellcheck disable=SC2086
        if ! "$PYTHON_BIN" "$PROSE_CHECK" --allow-vacuous --roots $STAGED_PY; then
            echo ""
            echo "Use a light LLM for the semantic judgement, or annotate a reviewed"
            echo "exception on the line:  # prose-matching-exempt: <why>"
            handle_failure "prose string-matching" || exit 1
        fi
    fi
fi

# 11. Topic-tag vocabulary gate and view regeneration (if installed).
# A `Topics:` tag in a module docstring must resolve against
# docs/topics/registry.yaml. Free-text tags fragment into near-duplicates and
# the aggregated view silently stops being one view -- the same pattern applied
# to entity identity in this ecosystem produced 4,226 ids for 190 distinct
# people. Commit time is the only point where the author still knows whether an
# unknown tag is a typo or a genuinely new topic. Regenerating on the way
# through is what makes a topic page a projection of the code rather than an
# artifact somebody has to remember to refresh.
TOPIC_VIEWS=$(find_script "topic_views.py")
if [[ -n "$TOPIC_VIEWS" ]] && [[ -f "$REPO_ROOT/docs/topics/registry.yaml" ]]; then
    echo "Checking topic tags..."
    if ! "$PYTHON_BIN" "$TOPIC_VIEWS" --root "$REPO_ROOT" --check --write >/dev/null; then
        echo ""
        echo "ERROR: undeclared topic tag."
        "$PYTHON_BIN" "$TOPIC_VIEWS" --root "$REPO_ROOT" --check >/dev/null || true
        echo "Declare it in docs/topics/registry.yaml with a one-sentence"
        echo "definition, or fix the tag."
        echo ""
        handle_failure "topic tag check" || exit 1
    fi
    if ! git diff --quiet -- docs/topics/views 2>/dev/null; then
        git add docs/topics/views
        echo "  topic views regenerated and staged"
    fi
fi

if [[ ${#WARNED_CHECKS[@]} -gt 0 ]]; then
    echo "Pre-commit checks completed with ${#WARNED_CHECKS[@]} warned (not passed): ${WARNED_CHECKS[*]}"
else
    echo "Pre-commit checks passed!"
fi
