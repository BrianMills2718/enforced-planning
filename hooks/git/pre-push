#!/bin/bash
# Pre-push hook: runs the global secret scan before any push.
# The coordination-claim check that used to follow it (check_push_safety.py, error missing_branch_claim)
# was removed because claims were retired (Brian, 2026-11-05, core.md).

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# git writes the refs being pushed to stdin once; the secret scan reads them.
REFS=$(cat)

# Global secret scan (gitleaks): core.hooksPath=hooks means git never reaches the global pre-push.
# A finding refuses the push; GITLEAKS_PREPUSH=off skips it for one push. Missing script: warn and allow,
# because this tracked hook also runs on machines without personal-file-infra.
SECRET_SCAN="${SECRET_SCAN_HOOK:-$HOME/code2/personal-file-infra/git-hooks/secret-scan.sh}"
if [[ -z "${_GIT_HOOK_CHAIN_ACTIVE:-}" ]]; then
    if [[ -x "$SECRET_SCAN" ]]; then
        printf '%s\n' "$REFS" | "$SECRET_SCAN" "$@" || exit 1
    else
        echo "pre-push: warning: secret scan $SECRET_SCAN not found; push not scanned for secrets." >&2
    fi
fi

exit 0
