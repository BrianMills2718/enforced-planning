# Enforced Planning Future / Advisory Configuration
#
# This file documents broader policy vocabulary that is not part of the minimum
# mechanically enforced config contract today. Copy selected sections into
# meta-process.yaml only when you intentionally want to record future policy or
# prepare for later enforcement.

meta_process:
  version: "1.0"

  plans:
    # Require "References Reviewed" section before implementation
    require_references_reviewed: true  # [PLANNED - not yet enforced by script]
    # Max lines for [Trivial] commits (no plan required)
    trivial_threshold_lines: 20  # [PLANNED - reference vocabulary only]
    # Block trivial commits that touch src/
    trivial_block_src: true  # [PLANNED - not yet enforced]

  claims:
    # Native pre-write claim gate: off | observe | enforce
    prewrite_mode: "off"
    # Block claiming already-claimed scopes
    enforce_exclusivity: true  # [PLANNED - not yet enforced]
    # CI verifies PR branches have claims
    enforce_in_ci: false  # [PLANNED - not yet enforced]
    # Claims file location (local, not git-tracked)
    claims_file: ".claude/active-work.yaml"  # [PLANNED - not yet enforced]

  worktrees:
    # Worktree location relative to project root
    worktree_dir: "../worktrees"  # [PLANNED - not yet enforced]
    # Use make worktree-remove instead of git worktree remove
    safe_remove_only: true  # [PLANNED - not yet enforced]

  planning:
    # Investigate before coding
    question_driven_planning: advisory  # disabled | advisory | required
    # Preserve open questions across sessions
    uncertainty_tracking: advisory  # disabled | advisory | required
    # How blocked dependency probes affect planning/freeze gates
    dependency_probe_policy: strict  # strict | warn | ignore

  capability_ownership:
    enabled: false
    source_of_record: ""
    shared_registry_required: false
    source_project: ""

  quality:
    doc_coupling:
      # Fail CI (true) or just warn (false)
      strict: true  # [PLANNED - current scripts block when enabled]

    mock_policy:
      enabled: true
      require_mock_ok_comment: true
      strict: true

    adr_governance:
      enabled: true
      config_file: "scripts/governance.yaml"
      sync_headers: true

    type_checking:
      enabled: true
      strict: true

  acceptance_gates:
    enabled: false
    gates_dir: "acceptance_gates"
    require_locked_specs: false
    min_criteria: 3
    required_categories:
      - happy_path
      - error_case
      - edge_case
    planning_modes:
      - autonomous
      - guided
      - detailed
      - iterative

  messaging:
    enabled: false  # [PLANNED - not yet enforced; send_message.py hardcodes paths]
    require_ack: true
    inbox_dir: ".claude/messages"
