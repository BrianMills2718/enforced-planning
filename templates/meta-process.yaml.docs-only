# Enforced Planning Configuration — Docs-Only Variant
# For documentation/governance repos (no src/, no pytest, no mypy)

meta_process:
  version: "1.0"

  plans:
    enabled: true
    require_tests: false
    require_references_reviewed: true
    trivial_threshold_lines: 20
    trivial_block_src: false
    plans_dir: "docs/plans"

  claims:
    enabled: false

  worktrees:
    enabled: false

  commits:
    require_prefix: true
    valid_prefixes:
      - "\\[Plan #\\d+\\]"
      - "\\[Goal [a-z0-9][a-z0-9._:-]*\\]"
      - "\\[Trivial\\]"
      - "\\[Unplanned\\]"

  planning:
    question_driven_planning: advisory
    uncertainty_tracking: advisory
    dependency_probe_policy: strict

  quality:
    doc_coupling:
      enabled: true
      strict: true
      config_file: "scripts/doc_coupling.yaml"

    mock_policy:
      enabled: false

    adr_governance:
      enabled: false

    type_checking:
      enabled: false

  acceptance_gates:
    enabled: false

  messaging:
    enabled: false

  ci:
    allow_disable_file: true
    jobs:
      test: false
      mypy: false
      fast_checks: true
      plan_checks: true
      post_merge_sync: false
    change_detection: false
