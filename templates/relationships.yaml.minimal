# Minimal governed-repo relationships graph scaffold.

required_reading:
  defaults:
    - CLAUDE.md

governance: []
couplings: []
architecture: []
adrs: {}
requirements: []
relationships: []

# Reviewed planning lineage example. A landscape informs downstream decisions;
# it does not become runtime truth or silently override those authorities.
# relationships:
#   - source: docs/research/2026-07-16-runtime-landscape.md
#     target: docs/requirements.md
#     relation: informs
#     reason: Prior art constrains requirements and the build/adopt boundary.
#     maintenance: reconcile
#   - source: docs/research/2026-07-16-runtime-landscape.md
#     target: docs/architecture/current/runtime.md
#     relation: informs
#     reason: The integration shape depends on the reviewed landscape.
#     maintenance: reconcile
#   - source: docs/research/2026-07-16-runtime-landscape.md
#     target: docs/adrs/ADR-0001-runtime-choice.md
#     relation: evidence_for
#     reason: The ADR records the durable choice made from this comparison.
#     maintenance: reconcile
#   - source: docs/research/2026-07-16-runtime-landscape.md
#     target: docs/plans/01_runtime_adapter.md
#     relation: informs
#     reason: The bounded slice implements the selected low-lock-in path.
#     maintenance: reconcile

# Optional report-only test-quality audit scope. Reviewed ``tests`` edges can
# link cohesive files or individual ``file.py::test_symbol`` selectors to
# requirements, boundaries, levels, polarity, realism, and failure modes.
# test_audit:
#   include: ["tests/**/*.py", "tests/*.py"]
#   mode: report_only

# Optional scoped file coverage policy.
# - managed: files under managed include that are NOT explicitly registered
#   in governance/couplings/architecture will trigger policy actions.
# - unmanaged: files outside managed scope.
#
# Set managed.mode: hard-fail to require an explicit registration for every
# managed file before edits are allowed. Set managed.mode: warn to log soft warnings
# instead. Keep generated/large directories out of scope with managed.exclude.
#
# file_scope:
#   managed:
#     include: ["**"]
#     exclude: [".venv/**", ".claude/**", "generated/**"]
#     mode: warn
#   unmanaged:
#     mode: ignore
